{
  "expo": {
    "name": "DEV MUSIC",
    "slug": "dev-music",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/profile.jpg",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paneer.devmusic",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/profile.jpg",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.paneer.devmusic"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f8455a89-42cb-4151-9c66-30d38a7e8d83"
      }
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
